# nyraflow desk — переменные окружения.
# На сервере живут в /opt/myland/.env (git-ignored), оттуда их читает compose.

# --- база ---------------------------------------------------------------
# Пароль используется и контейнером postgres, и строкой подключения ниже.
POSTGRES_DB=nyraflow
POSTGRES_USER=nyraflow
POSTGRES_PASSWORD=
DATABASE_URL=postgres://nyraflow:ПАРОЛЬ@db:5432/nyraflow

# --- telegram -----------------------------------------------------------
# Тот же бот, что принимает заявки с лендинга.
TELEGRAM_BOT_TOKEN=
# Куда лендинг шлёт заявки (уже используется приложением сайта).
TELEGRAM_CHAT_ID=
# Telegram id участников команды — получают роль admin в мини-аппе.
TELEGRAM_ADMIN_IDS=
# Публичный адрес мини-аппа (его же прописываем в BotFather).
MINIAPP_PUBLIC_URL=https://app.nyraflow.ru
# Сколько секунд initData считается свежей.
INIT_DATA_MAX_AGE_SECONDS=86400

# --- AI-разбор брифа ---------------------------------------------------
# Провайдер задаётся тройкой переменных. Настроен, только если заданы все три;
# ненастроенный слот молча пропускается. Смена провайдера — правка этих строк.
#
# Проверено на боевом сервере: gpt-oss-20b отвечает за ~2 с, а gpt-oss-120b
# может стоять в очереди бесплатного тарифа минутами. Быстрая модель — основная.
AI_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=openai/gpt-oss-20b

# Второй провайдер на случай отказа первого. Gemini с российского VPS не
# работает («User location is not supported»), поэтому слот пока пуст —
# кандидат на его место OpenRouter.
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=

# Модель для углублённого разбора вторым проходом (медленная, но умнее).
AI_DEEP_MODEL=openai/gpt-oss-120b
# Таймаут одного запроса к модели.
AI_TIMEOUT_MS=25000

# --- интеграции ---------------------------------------------------------
# Куда outbox шлёт события; подпись HMAC проверяется на стороне n8n.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Токен для входящего API (n8n двигает этапы, создаёт задачи и счета).
ADMIN_API_TOKEN=
