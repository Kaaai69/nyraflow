# Caddy сам выпускает и продлевает сертификаты Let's Encrypt.
# Условия: A-запись домена указывает на сервер, порты 80 и 443 открыты
# и (если включён VPN) входят в список исключений full-tunnel.

<DOMAIN> {
	encode zstd gzip
	reverse_proxy app:3000
}

www.<DOMAIN> {
	redir https://<DOMAIN>{uri} permanent
}

# --- Варианты ---
#
# Пока нет домена (доступ по IP, без HTTPS):
#
#   :80 {
#       encode zstd gzip
#       reverse_proxy app:3000
#   }
#
# Чистая статика без app-контейнера (SSG-сборка примонтирована в /srv):
#
#   <DOMAIN> {
#       encode zstd gzip
#       root * /srv
#       file_server
#       try_files {path} {path}/ /index.html
#   }
#
# Несколько лендингов на одном общем Caddy — просто добавляйте блоки:
#
#   another-client.ru {
#       encode zstd gzip
#       reverse_proxy another-app:3000
#   }
