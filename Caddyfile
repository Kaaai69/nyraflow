# MyLand reverse proxy with automatic HTTPS.
#
# Caddy provisions and renews Let's Encrypt certificates automatically for the
# domains below (ports 80 and 443 are published and firewall-exempt on the
# server). To run on a bare IP over HTTP instead, replace the block with:
#
#     :80 {
#         encode zstd gzip
#         reverse_proxy app:3000
#     }

{
	# Только HTTP/1.1 и HTTP/2.
	#
	# По умолчанию Caddy слушает ещё и UDP :443 (HTTP/3) и рекламирует его
	# заголовком `alt-svc: h3=":443"; ma=2592000`. Наружу этот порт не проброшен:
	# в docker-compose.yml опубликован только TCP («443:443»), да и VPN-исключение
	# /usr/local/sbin/vpn-exempt.sh метит connmark'ом лишь `-p tcp`, поэтому ответы
	# по QUIC ушли бы в туннель. Браузер же кеширует обещание HTTP/3 на 30 дней и
	# потом стучится в тишину — на нестабильной сети это выглядит как «сайт не
	# поддерживает защищённое подключение». Не обещаем того, чего не отдаём.
	servers {
		protocols h1 h2
	}
}

nyraflow.ru {
	encode zstd gzip
	reverse_proxy app:3000
}

www.nyraflow.ru {
	redir https://nyraflow.ru{uri} permanent
}

# nyraflow desk — Telegram Mini App.
app.nyraflow.ru {
	encode zstd gzip
	reverse_proxy miniapp:3000
}

# n8n — автоматизация сценариев.
#
# Админка, которой нечего делать в поиске: своего robots.txt n8n не отдаёт
# (SPA возвращает index.html на любой путь), поэтому закрываем заголовком —
# он действует на любой ответ, включая не-HTML.
n8n.nyraflow.ru {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy n8n:5678
}

# Парсер клиентов — операторская консоль.
#
# Приложение живёт в отдельном compose-проекте (/opt/client-parser-map) и
# подключено к сети myland_web через docker-compose.override.yml.
# Внутренний инструмент: из поиска закрываем заголовком.
parser.nyraflow.ru {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy client-parser-api:8000
}
